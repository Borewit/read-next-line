{
	"name": "read-next-line",
	"version": "0.5.1",
	"description": "Reads text lines from stream",
	"types": "./lib/read-next-line.d.ts",
	"engines": {
		"node": ">=18.7.0"
	},
	"type": "module",
	"main": "lib/read-next-line.cjs",
	"exports": {
		".": {
			"require": "./lib/read-next-line.cjs",
			"import": "./lib/read-next-line.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "del-cli 'lib/**/*.js' 'lib/**/*.cjs' 'lib/**/*.d.cts' 'lib/**/*.js.map' 'lib/**/*.d.ts' 'test/**/*.js' 'test/**/*.js.map' 'test/**/*.d.ts'",
		"compile": "tsc -p lib",
		"build": "yarn run clean && yarn run compile",
		"typecheck": "tsc -p lib/tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "yarn build && vitest run && yarn test:runtime",
		"test:runtime": "node --test test/runtime.test.mjs",
		"prepublishOnly": "yarn build"
	},
	"author": {
		"name": "Borewit",
		"url": "https://github.com/Borewit"
	},
	"repository": "https://github.com/Borewit/read-next-line.git",
	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/Borewit"
		},
		{
			"type": "buymeacoffee",
			"url": "https://buymeacoffee.com/borewit"
		}
	],
	"files": [
		"lib/**/*.js",
		"lib/**/*.d.ts",
		"lib/**/*.cjs",
		"lib/**/*.d.cts"
	],
	"packageManager": "yarn@4.18.1",
	"license": "MIT",
	"keywords": [
		"stream",
		"reader",
		"line",
		"line reader",
		"line-reader",
		"readable",
		"ReadableStream",
		"promise",
		"iterator",
		"stream-api",
		"UTF-16",
		"UTF-8",
		"BOM"
	],
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/node": "^22.20.5",
		"del-cli": "^6.0.0",
		"typescript": "^7.0.2",
		"vite": "^8.0.0",
		"vitest": "5.1.1"
	}
}
